# Reference repos kept locally for prompt/design lookups — never committed
ai-refs/

# Local-only MIS data dumps (PII — incentive amounts + employee names)
.mis-sheet*.json
Altus Eco System MIS.xlsx

# Stray local data/docs/archives (never source — keep out of the repo)
*.zip
*.xlsx
*.docx
~$*
# …but NOT App-Router route handlers whose dir is literally named e.g.
# `export.xlsx/` — the *.xlsx rule (for real spreadsheets) must never eat them,
# or ship.sh's `git add -A` silently drops the route and prod loses it.
!app/**/*.xlsx/
!app/**/*.xlsx/**
# …nor the hand-crafted Goals bulk-import template served by /goals/template.xlsx
# (bundled into the route via next.config outputFileTracingIncludes — it MUST be
# tracked or ship.sh drops it and the download 500s in prod).
!public/templates/*.xlsx
ALTUS_APP_KNOWLEDGE_BASE.md
Doc1.docx

# local salary reconcile exports (never ship)
_reconcile/

# local screenshot/PDF verification artifacts
.shots/
__claude-*.mjs

# Local PGlite dev database — a 67 MB Postgres data dir, never source. Must stay
# ignored or ship.sh's `git add -A` sweeps the whole thing into a commit.
#
# The glob covers the throwaway copies too: PGlite takes an EXCLUSIVE lock on
# its directory, so any test that writes (tests/integration/plan-move.test.ts)
# needs its own rather than sharing the one the dev server is holding open.
.pglite/
.pglite-*/

# legacy mobile drop - removed 2026-09-02
mobile_LEGACY_DROP_*/

.vercel
.env*

# Local backup snapshots — contains full DB rows (salary + PII) and git bundles.
# Never commit: 112MB and employee personal data.
/Altus Backup/

# Dummy-mode object storage — the local stand-in for the Supabase bucket.
.dummy-storage/

# Generated by next.config.ts for AI agents, same as CLAUDE.md above.
AGENTS.md

# Real names used ONLY to test Operations > Team Reporting locally.
# Read by scripts/dummy-db-seed.ts when present; never committed, so the
# test org chart cannot reach the repository or production.
scripts/dummy-team-tree.local.json

# Quarantined modules being rebuilt from scratch — kept on the developer's
# machine for reference and copy-paste, never committed. Git history is the
# real archive (`git show <sha>:<path>`); this is the convenience copy.
# Excluded from tsconfig too, so nothing in here is compiled or typechecked.
_archive/
